        ),
      ),
      body: SafeArea(
        child: LayoutBuilder(
          builder: (context, constraints) {
            final lebar = constraints.maxWidth;
            final kontenMaksimal = lebar > 760 ? 720.0 : lebar;

            return Center(
              child: SizedBox(
                width: kontenMaksimal,
                child: CustomScrollView(
                  slivers: [
                    SliverPadding(
                      padding: EdgeInsets.fromLTRB(
                        lebar > 760 ? 24 : 18,
