                        lebar > 760 ? 24 : 18,
                        110,
                      ),
                      sliver: SliverList(
                        delegate: SliverChildListDelegate([
                          Row(
                            children: [
                              Container(
                                width: 48,
                                height: 48,
                                decoration: BoxDecoration(
                                  gradient: const LinearGradient(
                                    colors: [_navy, _biru],
                                  ),
                                  borderRadius: BorderRadius.circular(16),
                                  boxShadow: [
                                    BoxShadow(
                                      color: _biru.withValues(alpha: 0.18),
                                      blurRadius: 12,
                                      offset: const Offset(0, 5),
                                    ),
                                  ],
                                ),
                                child: const Icon(
                                  Icons.account_balance_wallet_rounded,
                                  color: Colors.white,
                                  size: 24,
                                ),
                              ),
                              const SizedBox(width: 13),
                              const Expanded(
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Text(
                                      'Keuangan',
                                      style: TextStyle(
                                        color: _navy,
                                        fontSize: 24,
                                        fontWeight: FontWeight.w900,
                                        letterSpacing: -0.5,
                                      ),
                                    ),
                                    SizedBox(height: 3),
                                    Text(
                                      'Atur uang, capai tujuanmu.',
                                      style: TextStyle(
                                        color: _abu,
                                        fontSize: 12,
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                              Container(
                                decoration: BoxDecoration(
                                  color: Colors.white,
                                  borderRadius: BorderRadius.circular(14),
                                  border: Border.all(
                                    color: const Color(0xFFE5EBF4),
                                  ),
                                ),
                                child: IconButton(
                                  tooltip: 'Tambah transaksi',
                                  onPressed: _tambahTransaksiDialog,
                                  icon: const Icon(
                                    Icons.add_rounded,
                                    color: _navy,
                                  ),
                                ),
                              ),
                            ],
                          ),
                          const SizedBox(height: 22),

                          // Kartu biru: saldo dan progres anggaran.
                          _kartuUtama(lebar),

                          const SizedBox(height: 25),

                          // Ringkasan pemasukan dan pengeluaran tetap
                          // tersedia di luar kartu biru.
                          _judulBagian(
                            'Ringkasan Bulan Ini',
                            keterangan: DateFormat(
                              'MMMM yyyy',
                              'id_ID',
                            ).format(DateTime.now()),
                          ),
                          Row(
                            children: [
                              Expanded(
                                child: _kartuRingkasan(
                                  judul: 'Pemasukan',
                                  jumlah: _pemasukanBulanIni,
                                  ikon: Icons.south_west_rounded,
                                  warna: _hijau,
                                  keterangan: 'Bulan ini',
                                ),
                              ),
                              const SizedBox(width: 12),
                              Expanded(
                                child: _kartuRingkasan(
                                  judul: 'Pengeluaran',
                                  jumlah: _pengeluaranBulanIni,
                                  ikon: Icons.north_east_rounded,
                                  warna: _merah,
                                  keterangan: 'Bulan ini',
                                ),
                              ),
                            ],
                          ),
                          const SizedBox(height: 28),
                          _bagianAnggaran(),
                          const SizedBox(height: 28),
                          _bagianTabungan(),
                          const SizedBox(height: 28),
                          _bagianAnalisis(),
                          const SizedBox(height: 28),
